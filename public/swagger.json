    "components": {
        "schemas": {
            "AssistanceDemandRequest": {
                "required": [
                    "firstName",
                    "lastName",
                    "phone",
                    "assistanceType"
                ],
                "properties": {
                    "firstName": {
                        "description": "The first name of the person requesting assistance",
                        "type": "string"
                    },
                    "lastName": {
                        "description": "The last name of the person requesting assistance",
                        "type": "string"
                    },
                    "email": {
                        "description": "The email address of the person requesting assistance",
                        "type": "string",
                        "format": "email"
                    },
                    "phone": {
                        "description": "The phone number of the person requesting assistance",
                        "type": "string"
                    },
                    "description": {
                        "description": "The description of the assistance request",
                        "type": "string"
                    },
                    "voiceMessage": {
                        "description": "The voice message related to the assistance request",
                        "type": "string",
                        "format": "binary"
                    },
                    "file": {
                        "description": "The file attached to the assistance request",
                        "type": "string",
                        "format": "binary"
                    },
                    "assistanceType": {
                        "description": "The type of assistance requested",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "LostPersonRequest": {
                "required": [
                    "region"
                ],
                "properties": {
                    "firstName": {
                        "description": "The first name of the lost person",
                        "type": "string"
                    },
                    "lastName": {
                        "description": "The last name of the lost person",
                        "type": "string"
                    },
                    "email": {
                        "description": "The email address of the person reporting the lost person",
                        "type": "string",
                        "format": "email"
                    },
                    "phone": {
                        "description": "The phone number of the person reporting the lost person",
                        "type": "string"
                    },
                    "description": {
                        "description": "The description of the lost person",
                        "type": "string"
                    },
                    "voiceMessage": {
                        "description": "The voice message related to the lost person",
                        "type": "string",
                        "format": "binary"
                    },
                    "file": {
                        "description": "The file attached to the lost person report",
                        "type": "string",
                        "format": "binary"
                    },
                    "region": {
                        "description": "The region where the person was lost",
                        "type": "string"
                    },
                    "date": {
                        "description": "The date when the person was lost",
                        "type": "string",
                        "format": "date"
                    },
                    "nationality": {
                        "description": "The gender of the lost person",
                        "type": "string"
                    },
                    "age": {
                        "description": "The age of the lost person",
                        "type": "string"
                    },
                    "notificationSender": {
                        "description": "The person who submitted the request",
                        "type": "string"
                    },
                    "gender": {
                        "description": "The gender of lost person",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "TestimonyRequest": {
                "properties": {
                    "testimonyType": {
                        "description": "The type of the testimony",
                        "type": "string"
                    },
                    "firstName": {
                        "description": "The first name of the person giving the testimony",
                        "type": "string"
                    },
                    "lastName": {
                        "description": "The last name of the person giving the testimony",
                        "type": "string"
                    },
                    "email": {
                        "description": "The email address of the person giving the testimony",
                        "type": "string",
                        "format": "email"
                    },
                    "phone": {
                        "description": "The phone number of the person giving the testimony",
                        "type": "string"
                    },
                    "description": {
                        "description": "The description of the testimony",
                        "type": "string"
                    },
                    "voiceMessage": {
                        "description": "The voice message of the testimony",
                        "type": "string",
                        "format": "binary"
                    },
                    "file": {
                        "description": "The file attached to the testimony",
                        "type": "string",
                        "format": "binary"
                    }
                },
                "type": "object"
            },
            "CategoryResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Category Name"
                    }
                },
                "type": "object"
            },
            "DemandResource": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
