        "/news": {
            "get": {
                "tags": [
                    "News"
                ],
                "summary": "Get paginated list of news",
                "operationId": "b83ff020eb45141b07c365e50a4b27bd",
                "parameters": [
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Number of items per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    },
                    {
                        "name": "Accept-Language",
                        "in": "header",
                        "description": "The locale for the news items",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "en"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A paginated list of news",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "perPage": {
                                            "type": "integer"
                                        },
                                        "nextCursor": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "previousCursor": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "news": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/NewsResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
