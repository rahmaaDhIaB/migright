                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "categories": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Category 1"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "regions": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Region 1"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/demands": {
            "get": {
                "tags": [
                    "Demands"
                ],
                "summary": "Get demands by phone number",
                "description": "Retrieve a list of demands filtered by a given phone number.",
                "operationId": "7097d18d53c3f4a4ed8da70b390688cc",
