                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "demands": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/DemandResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request. Phone number is required."
                    }
                }
            }
        },
