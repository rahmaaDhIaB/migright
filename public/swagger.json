                                        "errors": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "properties": {
                                                    "": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        }
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
